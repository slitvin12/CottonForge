<Project Sdk="Microsoft.NET.Sdk">
  <!--
    CottonForge (fork of Cotton Library). Drop-in replacement for CottonLibrary.dll: same assembly name, namespaces and public API.
    Build:   dotnet build -c Release            -> bin\Release\net6.0\CottonLibrary.dll (+ CottonLibrary.xml)
    Deploy:  dotnet build -c Release -p:Deploy=true   (copies into $(SR2Dir)\Mods, keeps CottonLibrary.dll.orig once)
    Game path: -p:SR2Dir=... or a Libs\ folder with the referenced assemblies (upstream layout).
  -->
  <PropertyGroup>
    <TargetFramework>net6.0</TargetFramework>
    <AssemblyName>CottonLibrary</AssemblyName>
    <RootNamespace>CottonLibrary</RootNamespace>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <DebugType>embedded</DebugType>
    <DebugSymbols>true</DebugSymbols>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
    <EnableDefaultEmbeddedResourceItems>false</EnableDefaultEmbeddedResourceItems>
    <NoWarn>CS0618;CS8632;CS1591;CS1572;CS1573;CS1574;CS0649;CS0414;CS0169</NoWarn>
    <!-- AssemblyVersion must stay 1.0.0.0: mods are compiled against it (upstream Cotton never changed it).
         The fork version lives in FileVersion / InformationalVersion ("0.3.2+<git rev>[.dirty]", see ForgeGitRevision). -->
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <FileVersion>0.3.2.0</FileVersion>
    <InformationalVersion>0.3.2</InformationalVersion>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <SR2Dir Condition="'$(SR2Dir)'==''">D:\SteamLibrary\steamapps\common\Slime Rancher 2</SR2Dir>
    <RefML Condition="Exists('Libs\MelonLoader.dll')">Libs</RefML>
    <RefML Condition="'$(RefML)'==''">$(SR2Dir)\MelonLoader\net6</RefML>
    <RefIl2Cpp Condition="Exists('Libs\Assembly-CSharp.dll')">Libs</RefIl2Cpp>
    <RefIl2Cpp Condition="'$(RefIl2Cpp)'==''">$(SR2Dir)\MelonLoader\Il2CppAssemblies</RefIl2Cpp>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="$(RefML)\MelonLoader.dll" Private="false" />
    <Reference Include="$(RefML)\0Harmony.dll" Private="false" />
    <Reference Include="$(RefML)\Il2CppInterop.Runtime.dll" Private="false" />
    <Reference Include="$(RefML)\Il2CppInterop.Common.dll" Private="false" />
    <Reference Include="$(RefML)\UnityEngine.Il2CppImageConversionManager.dll" Private="false" />
    <Reference Include="$(RefML)\UnityEngine.Il2CppAssetBundleManager.dll" Private="false" Condition="Exists('$(RefML)\UnityEngine.Il2CppAssetBundleManager.dll')" />
    <Reference Include="$(RefIl2Cpp)\*.dll" Exclude="$(RefIl2Cpp)\MelonLoader.dll;$(RefIl2Cpp)\0Harmony.dll;$(RefIl2Cpp)\Il2CppInterop*.dll" Private="false" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="TestMod\**;PureLargosSR2\**;Largordos\**;ColorSlimes\**;examples\**;bin\**;obj\**" />
    <None Remove="TestMod\**;PureLargosSR2\**;Largordos\**;ColorSlimes\**;examples\**" />
  </ItemGroup>

  <!-- Appends the git revision (and ".dirty" for uncommitted tracked changes) to InformationalVersion; silent without git. -->
  <Target Name="ForgeGitRevision" BeforeTargets="GetAssemblyAttributes">
    <Exec Command="git rev-parse --short HEAD" WorkingDirectory="$(MSBuildProjectDirectory)" ConsoleToMSBuild="true" StandardOutputImportance="low" StandardErrorImportance="low" IgnoreExitCode="true" IgnoreStandardErrorWarningFormat="true" ContinueOnError="true">
      <Output TaskParameter="ConsoleOutput" PropertyName="ForgeRev" />
      <Output TaskParameter="ExitCode" PropertyName="ForgeRevExit" />
    </Exec>
    <Exec Command="git status --porcelain --untracked-files=no" WorkingDirectory="$(MSBuildProjectDirectory)" ConsoleToMSBuild="true" StandardOutputImportance="low" StandardErrorImportance="low" IgnoreExitCode="true" IgnoreStandardErrorWarningFormat="true" ContinueOnError="true" Condition="'$(ForgeRevExit)'=='0'">
      <Output TaskParameter="ConsoleOutput" PropertyName="ForgeDirty" />
    </Exec>
    <PropertyGroup Condition="'$(ForgeRevExit)'=='0' And '$(ForgeRev)'!=''">
      <InformationalVersion>$(InformationalVersion)+$(ForgeRev)</InformationalVersion>
      <InformationalVersion Condition="'$(ForgeDirty)'!=''">$(InformationalVersion).dirty</InformationalVersion>
    </PropertyGroup>
  </Target>

  <Target Name="Deploy" AfterTargets="Build" Condition="'$(Deploy)'=='true'">
    <Copy SourceFiles="$(SR2Dir)\Mods\CottonLibrary.dll" DestinationFiles="$(SR2Dir)\Mods\CottonLibrary.dll.orig" Condition="!Exists('$(SR2Dir)\Mods\CottonLibrary.dll.orig') And Exists('$(SR2Dir)\Mods\CottonLibrary.dll')" />
    <Copy SourceFiles="$(TargetPath);$(TargetDir)$(AssemblyName).xml" DestinationFolder="$(SR2Dir)\Mods" />
  </Target>
</Project>
