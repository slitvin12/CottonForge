<Project Sdk="Microsoft.NET.Sdk">
  <!-- Minimal Cotton Forge content mod. Build: dotnet build -c Release (add -p:Deploy=true to copy into Mods). -->
  <PropertyGroup>
    <TargetFramework>net6.0</TargetFramework>
    <AssemblyName>ForgeExample</AssemblyName>
    <RootNamespace>ForgeExample</RootNamespace>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <DebugType>embedded</DebugType>
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
    <EnableDefaultEmbeddedResourceItems>false</EnableDefaultEmbeddedResourceItems>
    <SR2Dir Condition="'$(SR2Dir)'==''">D:\SteamLibrary\steamapps\common\Slime Rancher 2</SR2Dir>
    <NoWarn>CS0618;CS8632</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <!-- localized.csv, icons (iconSlime<Name>.png, iconPlort<Name>.png), sounds ... -->
    <EmbeddedResource Include="Assets\**\*" />
  </ItemGroup>
  <ItemGroup>
    <!-- in your own mod: <Reference Include="$(SR2Dir)\Mods\CottonLibrary.dll" Private="false" /> -->
    <ProjectReference Include="..\..\CottonLibrary.csproj" Private="false" />
    <Reference Include="$(SR2Dir)\MelonLoader\net6\MelonLoader.dll" Private="false" />
    <Reference Include="$(SR2Dir)\MelonLoader\net6\0Harmony.dll" Private="false" />
    <Reference Include="$(SR2Dir)\MelonLoader\net6\Il2CppInterop.Runtime.dll" Private="false" />
    <Reference Include="$(SR2Dir)\MelonLoader\net6\Il2CppInterop.Common.dll" Private="false" />
    <Reference Include="$(SR2Dir)\MelonLoader\Il2CppAssemblies\*.dll" Private="false" />
  </ItemGroup>
  <Target Name="Deploy" AfterTargets="Build" Condition="'$(Deploy)'=='true'">
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(SR2Dir)\Mods" />
  </Target>
</Project>
